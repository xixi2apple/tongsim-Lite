  "Modules": [
    {
      "Name": "TongSimRobot",
      "Type": "Runtime",
      "LoadingPhase": "Default",
      "WhitelistPlatforms": [
        "Linux"
      ]
    },
    {
      "Name": "TongSimRobotEditor",
      "Type": "Editor",
      "LoadingPhase": "Default",
      "WhitelistPlatforms": [
        "Linux"
      ],
      "Dependencies": [
        "TongSimRobot"
      ]
    }
  ]
}